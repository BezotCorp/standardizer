{
  "name": "standardizer-release-automation",
  "version": "0.0.0",
  "private": true,
  "description": "Release automation for the Standardizer Rust workspace",
  "scripts": {
    "setup": "pnpm install --lockfile-only --ignore-workspace && cargo build --all-targets --all-features",
    "release:prepare": "node scripts/release/prepare-release.mjs"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "semantic-release": "^25.0.5"
  },
  "packageManager": "pnpm@11.12.0+sha512.820a6fbd0d9f04c226638002aead1e45340a9139dd5dc077c1d83ef44aa2481c8eb6637b4c9aa696a3c7e35ba818e49cf27213e5f2b91138d09b7a3e26e898ba"
}
